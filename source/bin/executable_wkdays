#!/usr/bin/env python3

import argparse
import calendar
from dataclasses import dataclass
from datetime import datetime
import math
import os

WORKDAY_START_HOUR = 9
WORKDAY_END_HOUR = 17
WORKDAY_DURATION_HOURS = WORKDAY_END_HOUR - WORKDAY_START_HOUR
WEEKDAY_HEADING = "weekday_heading"
PAST_DAY = "past_day"
TODAY = "today"
FUTURE_DAY = "future_day"
DATE_HEADING = "date_heading"
ELAPSED_PERCENTAGE = "elapsed_percentage"
LABEL = "label"
RESET = "\033[0m"
STYLE_CODES = {
    WEEKDAY_HEADING: "\033[2m",
    PAST_DAY: "\033[2m",
    TODAY: "\033[1;35m",
    DATE_HEADING: "\033[36m",
    ELAPSED_PERCENTAGE: "\033[1;35m",
    LABEL: "\033[1m",
}


@dataclass(frozen=True)
class Fragment:
    text: str
    role: str | None = None


@dataclass(frozen=True)
class DashboardRow:
    left: tuple[Fragment, ...]
    right: tuple[Fragment, ...] = ()


@dataclass(frozen=True)
class MonthProgress:
    now: datetime
    weeks: tuple[tuple[int, ...], ...]
    weekday_total: int
    weekday_elapsed: float
    remaining: float
    percentage_elapsed: float
    percentage_remaining: float


@dataclass(frozen=True)
class DisplayProgress:
    elapsed_weekdays: int
    remaining_weekdays: int
    elapsed_percentage: float
    remaining_percentage: float


def build_month_progress(now: datetime) -> MonthProgress:
    month_calendar = calendar.Calendar(firstweekday=calendar.SUNDAY)
    weeks = tuple(
        tuple(week) for week in month_calendar.monthdayscalendar(now.year, now.month)
    )
    weekday_total = 0
    weekday_elapsed = 0.0

    for day in range(1, calendar.monthrange(now.year, now.month)[1] + 1):
        weekday = datetime(now.year, now.month, day).weekday()
        if weekday >= 5:
            continue

        weekday_total += 1
        if day < now.day:
            weekday_elapsed += 1
        elif day == now.day and now.weekday() < 5:
            clock_hours = now.hour + now.minute / 60 + now.second / 3600
            partial_hours = min(
                max(clock_hours - WORKDAY_START_HOUR, 0.0), WORKDAY_DURATION_HOURS
            )
            weekday_elapsed += partial_hours / WORKDAY_DURATION_HOURS

    remaining = max(weekday_total - weekday_elapsed, 0.0)
    percentage_elapsed = weekday_elapsed / weekday_total * 100 if weekday_total else 0.0
    percentage_remaining = remaining / weekday_total * 100 if weekday_total else 0.0
    return MonthProgress(
        now=now,
        weeks=weeks,
        weekday_total=weekday_total,
        weekday_elapsed=weekday_elapsed,
        remaining=remaining,
        percentage_elapsed=percentage_elapsed,
        percentage_remaining=percentage_remaining,
    )


def display_progress(progress: MonthProgress) -> DisplayProgress:
    elapsed_percentage = round(progress.percentage_elapsed, 1)
    return DisplayProgress(
        elapsed_weekdays=math.floor(progress.weekday_elapsed),
        remaining_weekdays=math.ceil(progress.remaining),
        elapsed_percentage=elapsed_percentage,
        remaining_percentage=100.0 - elapsed_percentage,
    )


def ordinal_suffix(day: int) -> str:
    if 10 < day % 100 < 14:
        return "th"
    return {1: "st", 2: "nd", 3: "rd"}.get(day % 10, "th")


def calendar_week_fragments(
    week: tuple[int, ...], current_day: int
) -> tuple[Fragment, ...]:
    fragments = []
    for index, day in enumerate(week):
        role = None
        if day:
            if day < current_day:
                role = PAST_DAY
            elif day == current_day:
                role = TODAY
            else:
                role = FUTURE_DAY
        fragments.append(Fragment(f"{day:2d}" if day else "  ", role))
        if index < len(week) - 1:
            fragments.append(Fragment(" "))
    return tuple(fragments)


def dashboard_rows(progress: MonthProgress) -> tuple[DashboardRow, ...]:
    display = display_progress(progress)
    date_heading = (
        f"{progress.now:%A}, {progress.now:%B} {progress.now.day}"
        f"{ordinal_suffix(progress.now.day)}, {progress.now.year}"
    )
    elapsed_count = f" {display.elapsed_weekdays}/{progress.weekday_total} weekdays ("
    elapsed_percentage = f"{display.elapsed_percentage:.1f}%"
    remaining = (
        f" {display.remaining_weekdays} weekdays ({display.remaining_percentage:.1f}%)"
    )
    right_rows = (
        (Fragment(date_heading, DATE_HEADING),),
        (),
        (
            Fragment("Elapsed:", LABEL),
            Fragment(elapsed_count),
            Fragment(elapsed_percentage, ELAPSED_PERCENTAGE),
            Fragment(")"),
        ),
        (Fragment("Remaining:", LABEL), Fragment(remaining)),
    )
    left_rows = [(Fragment("Su Mo Tu We Th Fr Sa", WEEKDAY_HEADING),)]
    left_rows.extend(
        calendar_week_fragments(week, progress.now.day) for week in progress.weeks
    )

    return tuple(
        DashboardRow(left, right_rows[index] if index < len(right_rows) else ())
        for index, left in enumerate(left_rows)
    )


def render_fragments(fragments: tuple[Fragment, ...], color: bool) -> str:
    rendered = []
    for fragment in fragments:
        if color and fragment.role in STYLE_CODES:
            rendered.append(f"{STYLE_CODES[fragment.role]}{fragment.text}{RESET}")
        else:
            rendered.append(fragment.text)
    return "".join(rendered)


def render_dashboard(progress: MonthProgress, color: bool) -> str:
    rows = dashboard_rows(progress)
    left_width = max(len("".join(fragment.text for fragment in row.left)) for row in rows)
    rendered_rows = []

    for row in rows:
        left_text = "".join(fragment.text for fragment in row.left)
        left = row.left + (Fragment(" " * (left_width - len(left_text))),)
        if row.right:
            rendered_rows.append(
                f"{render_fragments(left, color)}  {render_fragments(row.right, color)}"
            )
        else:
            rendered_rows.append(render_fragments(left, color).rstrip())

    return "\n".join(rendered_rows)


def render_terse(progress: MonthProgress) -> str:
    display = display_progress(progress)
    return (
        f"Weekdays elapsed in {progress.now:%b %Y}: "
        f"{display.elapsed_weekdays}/{progress.weekday_total} "
        f"({display.elapsed_percentage:.1f}%)"
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Counts Monday through Friday as weekdays. The current weekday accrues "
            "from 09:00 to 17:00 local time."
        )
    )
    parser.add_argument("--terse", action="store_true", help="show a one-line summary")
    parser.add_argument("--no-color", action="store_true", help="disable terminal decoration")
    arguments = parser.parse_args(argv)

    progress = build_month_progress(datetime.now())
    if arguments.terse:
        print(render_terse(progress))
    else:
        print(
            render_dashboard(
                progress,
                color=not arguments.no_color and "NO_COLOR" not in os.environ,
            )
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
