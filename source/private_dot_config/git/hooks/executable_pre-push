#!/usr/bin/env bash
# pre-push: offer to format PHP files in the pushed range with Laravel Pint.
#
# Exits early when the push has no PHP changes or no terminal is available.
# Pint parse errors abort the push. Formatting changes are committed by
# `git pint --blame-ignore`, and the push is aborted so they can be reviewed.
#
# Debug: PREPUSH_DEBUG=1 prints the hook arguments and stdin.
# Bypass: git push --no-verify

set -euo pipefail

remote_name="${1-}"
remote_url="${2-}"
scripts_dir="${XDG_CONFIG_HOME:-$HOME/.config}/git/scripts"

push_stdin=$(cat)

if [[ -n "${PREPUSH_DEBUG-}" ]]; then
  {
    echo "pre-push args: remote_name=$remote_name remote_url=$remote_url"
    echo "pre-push stdin (local_ref local_sha remote_ref remote_sha):"
    echo "$push_stdin"
  } >&2
fi

head_sha=$(git rev-parse HEAD)
raw_files=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  [[ "$remote_ref" == refs/heads/* ]] || continue

  # Pint formats the working tree and `git pint` commits onto HEAD.
  if [[ "$local_sha" != "$head_sha" ]]; then
    echo "pre-push: skipping $local_ref (not the checked-out commit)" >&2
    continue
  fi

  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # New remote branch: commits no remote-tracking ref contains.
    remotes_filter="--remotes=$remote_name"
    if [[ -z "$(git for-each-ref --count=1 "refs/remotes/$remote_name" 2>/dev/null)" ]]; then
      remotes_filter="--remotes"
    fi
    listed=$(git log --format= --name-only -z --diff-filter=ACMR "$local_sha" --not "$remotes_filter" -- '*.php' | tr '\0' '\n' || true)
  else
    listed=$(git diff --name-only -z --diff-filter=ACMR "$remote_sha..$local_sha" -- '*.php' 2>/dev/null | tr '\0' '\n' || true)
  fi
  raw_files+="$listed"$'\n'
done <<< "$push_stdin"

files=()
while IFS= read -r line; do
  if [[ -n "$line" ]]; then
    files+=("$line")
  fi
done < <(printf '%s' "$raw_files" | sort -u)

if ((${#files[@]} == 0)); then
  exit 0
fi

if ! (: </dev/tty) 2>/dev/null; then
  echo "pre-push: PHP files changed but no terminal is available; skipping Pint (run 'git pint')" >&2
  exit 0
fi

set +e
"$scripts_dir/git-pint.sh" --test -- "${files[@]}"
status=$?
set -e

case "$status" in
  0 | 3) exit 0 ;;
  1) ;;
  *)
    echo "pre-push: push aborted; fix the errors above (bypass: git push --no-verify)" >&2
    exit 1
    ;;
esac

while true; do
  printf 'Format with Pint? [y]es / [N]o, push as is / [d]iff / [a]bort push: ' >&2
  IFS= read -r answer </dev/tty || answer=n
  answer=$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')
  case "$answer" in
    y | yes)
      formatted=()
      while IFS= read -r line; do
        [[ -n "$line" ]] && formatted+=("$line")
      done < <("$scripts_dir/git-pint.sh" -- "${files[@]}" || true)
      if ((${#formatted[@]})); then
        "$scripts_dir/git-commit-format.sh" -- "${formatted[@]}" >/dev/null || true
      fi
      echo "" >&2
      echo "Push aborted so you can review the formatting commit(s); run 'git push' again." >&2
      exit 1
      ;;
    d | diff)
      "$scripts_dir/git-pint.sh" --diff -- "${files[@]}" || true
      ;;
    a | abort)
      echo "pre-push: push aborted" >&2
      exit 1
      ;;
    n | no | "") exit 0 ;;
  esac
done
