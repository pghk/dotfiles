[user]
	name = Paul Hendrick
	email = {{ .email }}

[core]
	excludesfile = ~/.config/git/ignore

[pull]
	ff = only

[init]
	defaultBranch = local/dev

[diff]
	tool = Kaleidoscope

[diff "plist"]
	textconv = plutil -convert xml1 -o -

[merge]
	tool = Kaleidoscope
	conflictStyle = diff3

[rebase]
	autosquash = true
	updateRefs = true

[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"

[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustexitcode = true

[alias]
	last = log -n 1
	sha = rev-parse --short HEAD
	graph = log --oneline --decorate --graph
	re-author = "!GIT_AUTHOR_DATE=$(git show -s --format=%ad @) git commit --amend --reset-author"
	unpushed = log --branches --not --remotes --no-walk --decorate --oneline
	blame-ignore = "!$XDG_CONFIG_HOME/git/scripts/git-blame-ignore.sh"
	prev-branch = "!git reflog | grep -o 'checkout: moving from [^ ]* to [^ ]*' | awk '{print $NF}' | awk '!seen[$0]++' | tail -n +2 | head -n 1"
	branch-hist = "!git reflog | grep -o 'checkout: moving from [^ ]* to [^ ]*' | awk '{print $NF}' | awk '!seen[$0]++' | tail -n +2 | head"
	diff-grep = !$XDG_CONFIG_HOME/git/scripts/git-diff-grep.sh
	new = "!$XDG_CONFIG_HOME/git/scripts/git-create-work-branch.sh new"
	pr  = "!$XDG_CONFIG_HOME/git/scripts/git-create-work-branch.sh pr"
	tree-shake = "!$XDG_CONFIG_HOME/git/scripts/git-trash-mark.sh"
	trash-empty = "!$XDG_CONFIG_HOME/git/scripts/git-trash-empty.sh"
	backup = "!$XDG_CONFIG_HOME/git/scripts/git-trash-copy.sh"
