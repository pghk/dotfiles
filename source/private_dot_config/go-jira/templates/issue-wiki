{{/* issue-wiki: one issue as Jira wiki markup, for `pandoc -f jira` to convert to markdown (see jira-md). The frontmatter code block becomes YAML front matter in jira-md.lua. */ -}}
{code:frontmatter}
issue: {{ .key }}
summary: {{ toMinJson .fields.summary }}
url: {{ toMinJson (print (regReplace "/rest/api/.*" "" .self) "/browse/" .key) }}
type: {{ toMinJson .fields.issuetype.name }}
status: {{ toMinJson .fields.status.name }}
{{ if .fields.resolution -}}
resolution: {{ toMinJson .fields.resolution.name }}
{{ end -}}
{{ if .fields.priority -}}
priority: {{ toMinJson .fields.priority.name }}
{{ end -}}
{{ if .fields.assignee -}}
assignee: {{ toMinJson .fields.assignee.displayName }}
{{ end -}}
{{ if .fields.reporter -}}
reporter: {{ toMinJson .fields.reporter.displayName }}
{{ end -}}
created_at: {{ toMinJson .fields.created }}
updated_at: {{ toMinJson .fields.updated }}
{{ if .fields.parent -}}
parent: {{ .fields.parent.key }}
{{ end -}}
{{ if .fields.labels -}}
labels: {{ toMinJson .fields.labels }}
{{ end -}}
{{ if .fields.components -}}
components: [{{ range $i, $c := .fields.components }}{{ if $i }}, {{ end }}{{ toMinJson $c.name }}{{ end }}]
{{ end -}}
{{ if .fields.fixVersions -}}
fix_versions: [{{ range $i, $v := .fields.fixVersions }}{{ if $i }}, {{ end }}{{ toMinJson $v.name }}{{ end }}]
{{ end -}}
{code}

h1. {{ .key }}: {{ .fields.summary }}

h2. Description

{{ or .fields.description "(none)" }}
{{ if .fields.subtasks }}
h2. Subtasks

{{ range .fields.subtasks -}}
* {{ .key }} \[{{ .fields.status.name }}\] {{ .fields.summary }}
{{ end -}}
{{ end -}}
{{ if .fields.issuelinks }}
h2. Links

{{ range .fields.issuelinks -}}
{{ if .outwardIssue -}}
* {{ .type.outward }} {{ .outwardIssue.key }} \[{{ .outwardIssue.fields.status.name }}\] {{ .outwardIssue.fields.summary }}
{{ end -}}
{{ if .inwardIssue -}}
* {{ .type.inward }} {{ .inwardIssue.key }} \[{{ .inwardIssue.fields.status.name }}\] {{ .inwardIssue.fields.summary }}
{{ end -}}
{{ end -}}
{{ end -}}
{{ if .fields.attachment }}
h2. Attachments

{{ range .fields.attachment -}}
* [{{ .filename }}|{{ .content }}] ({{ .mimeType }})
{{ end -}}
{{ end -}}
{{ if .fields.comment.comments }}
h2. Comments
{{ range .fields.comment.comments }}
h3. {{ .author.displayName }}, [{{ .created }}|{{ regReplace "/rest/api/.*" "" $.self }}/browse/{{ $.key }}?focusedCommentId={{ .id }}]

{{ or .body "" }}
{{ end -}}
{{ end -}}
