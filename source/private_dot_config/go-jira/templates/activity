{{/* The user's own field changes and comments from today, grouped under each issue's key, current status and summary. */ -}}
{{ define "adf" }}{{ $node := .node }}{{ $item := eq .parent "listItem" -}}
{{ if eq $node.type "text" }}{{ $node.text }}{{ else if eq $node.type "mention" }}{{ $node.attrs.text }}{{ else if eq $node.type "hardBreak" }}
    {{ else -}}
{{ if eq $node.type "heading" }}    {{ repeat (int $node.attrs.level) "#" }} {{ else if eq $node.type "listItem" }}    - {{ else if and (eq $node.type "paragraph") (not $item) }}    {{ end -}}
{{ range $node.content }}{{ template "adf" (dict "node" . "parent" $node.type) }}{{ end -}}
{{ if or (eq $node.type "heading") (eq $node.type "paragraph") }}
{{ end }}{{ end }}{{ end -}}
{{ $me := env.JIRA_USER }}{{ $today := now | date "2006-01-02" -}}
{{ range .issues -}}
{{ $changes := list }}{{ range .changelog.histories }}{{ if and (eq .author.emailAddress $me) (hasPrefix $today .created) }}{{ $changes = push $changes . }}{{ end }}{{ end -}}
{{ $comments := list }}{{ range .fields.comment.comments }}{{ if and (eq .author.emailAddress $me) (hasPrefix $today .created) }}{{ $comments = push $comments . }}{{ end }}{{ end -}}
{{ if or $changes $comments }}{{ .key }} [{{ .fields.status.name }}] {{ .fields.summary }}
{{ range $changes }}{{ $time := substr 11 16 .created }}{{ range .items }}  {{ $time }} {{ .field }}: {{ .fromString | default "none" | abbrev 60 }} -> {{ .toString | default "none" | abbrev 60 }}
{{ end }}{{ end -}}
{{ range $comments }}  {{ substr 11 16 .created }} comment:
{{ template "adf" (dict "node" .body "parent" "") }}{{ end }}{{ end -}}
{{ end -}}
