# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

alias dot=chezmoi

# Pick rows from keyed-tsv input (key first, tab-separated) on stdin and print their keys, one per line.
alias pick-keyed="column -t -s \$'\t' | fzf --no-sort | awk '{print \$1}'"

# Search summaries, descriptions and comments for TERM in the configured project; extra arguments go to `jira ls`.
jira-search() {
  local term=${1//\\/\\\\} project
  term=${term//\"/\\\"}
  project=$(awk '/^project:/ {print $2}' ~/.jira.d/config.yml)
  jira ls -q "project = $project AND text ~ \"$term\" ORDER BY updated DESC" "${@:2}"
}

# Print an issue as markdown: the issue-wiki template renders Jira wiki markup and pandoc converts it.
jira-md() {
  jira view -t issue-wiki "$1" | pandoc -f jira -t gfm --wrap=none --lua-filter ~/.config/go-jira/jira-md.lua
}

# Make Vi mode transitions faster (KEYTIMEOUT is in hundredths of a second)
export KEYTIMEOUT=1

# Store history in a database, using https://atuin.sh
if (( $+commands[atuin] )); then
  eval "$(atuin init zsh --disable-up-arrow)"
  _zsh_autosuggest_strategy_atuin() {
      suggestion=$(atuin search --exit 0 --cmd-only --limit 1 --search-mode prefix "$1")
  }
fi

ADDENDUM="${ZDOTDIR:-$HOME}/.zshrc_custom"; [ -f $ADDENDUM ] && . $ADDENDUM
