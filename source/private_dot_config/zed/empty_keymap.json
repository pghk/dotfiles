[
  {
    "context": "vim_mode == visual",
    "bindings": {
      "J": "editor::MoveLineDown",
      "K": "editor::MoveLineUp"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "shift-l": "pane::activate_next_item",
      "shift-h": "pane::activate_previous_item"
    }
  }
]
