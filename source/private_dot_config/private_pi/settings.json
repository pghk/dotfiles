{
  "lastChangelogVersion": "0.99.2",
  "theme": "dark",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access"
  ],
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultModel": "gpt-5.6-terra",
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "model": "mai-code-1.1-flash",
        "thinking": "low",
        "defaultContext": "fresh"
      },
      "researcher": {
        "model": "gpt-5.6-luna",
        "thinking": "high",
        "defaultContext": "fresh"
      },
      "worker": {
        "model": "gpt-5.6-luna",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "model": "claude-sonnet-5",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "delegate": {
        "model": "gpt-5.6-terra",
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "oracle": {
        "model": "gpt-5.6-sol",
        "thinking": "high",
        "defaultContext": "fork"
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": true,
      "agents": {
        "scout": {
          "allow": [
            "*/mai-code-1.1-flash"
          ]
        },
        "researcher": {
          "allow": [
            "*/mai-code-1.1-flash",
            "*/gpt-5.6-luna"
          ]
        },
        "worker": {
          "allow": [
            "*/mai-code-1.1-flash",
            "*/gpt-5.6-luna",
            "*/gpt-5.6-terra"
          ]
        },
        "reviewer": {
          "allow": [
            "*/claude-sonnet-5",
            "*/gpt-5.6-sol"
          ]
        },
        "delegate": {
          "allow": [
            "*/gpt-5.6-luna",
            "*/gpt-5.6-terra"
          ]
        },
        "oracle": {
          "allow": [
            "*/gpt-5.6-sol",
            "*/claude-opus-5"
          ]
        },
        "task-reviewer": {
          "allow": [
            "*/gpt-5.6-terra",
            "*/gpt-5.6-sol"
          ]
        }
      }
    }
  }
}