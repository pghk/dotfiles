{{- $headless := env "CI" -}}

{{- if not $headless -}}

{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $profiles := list "Shell" "Personal" "Work" -}}
{{- $profile := promptChoice "Install profile" $profiles -}}

[data]
    email = {{ $email | quote }}
    profile = {{ $profile | quote }}
    {{- if not (eq $profile "Shell") }}
    opVault = {{ $profile | quote }}
    {{- end }}

[merge]
    command = "code"

[[textconv]]
    pattern = "**/*.plist"
    command = "plutil"
    args = ["-convert", "xml1", "-o", "-", "-"]

{{- end -}}
